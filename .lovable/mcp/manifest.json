{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://eigfbhrbrcytaalswrhq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "auramatch-connect",
      "version": "0.1.0",
      "title": "AuraMatch Connect"
    },
    "tools": [
      {
        "name": "get_my_chart",
        "title": "Get my Human Design chart",
        "description": "Return the signed-in user's Human Design profile: energy type, strategy, authority, profile, definition, incarnation cross, defined centers and gates, PHS variables, and nodal environments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_matches",
        "title": "List my matches",
        "description": "List the signed-in user's matches with chemistry score, dominant connection theme, status, and the partner's Human Design basics.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Optional status filter, e.g. 'active'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum matches to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_messages",
        "title": "List messages in a match",
        "description": "Read the conversation for one of the signed-in user's matches, oldest message first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "description": "Match id from list_matches."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum messages to return."
            }
          },
          "required": [
            "match_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_message",
        "title": "Send a message to a match",
        "description": "Send a chat message as the signed-in user in one of their matches.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "description": "Match id from list_matches."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Message text to send."
            }
          },
          "required": [
            "match_id",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_unleash_checks",
        "title": "List my Unleash Checks",
        "description": "List the signed-in user's authority-based Unleash Checks, including when each becomes available, the response, and any reflection.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional match id to filter by."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum checks to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
